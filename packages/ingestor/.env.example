# ============================================================
# INGESTOR SERVICE — Environment Variables
# Deployed on: Railway / Render / Fly.io (any Node.js host)
# Port: 4317
# ============================================================

# --- PostgreSQL (Neon) ---
# Set this in your hosting platform's Environment Variables panel.
# Value: copy from Neon dashboard → Connection string (pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clickhouse ---
# Set this in your hosting platform's Environment Variables panel.
# Value: your Clickhouse Cloud URL (e.g. https://xxx.clickhouse.cloud:8443)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# --- Redis (optional, for rate limiting) ---
# If not set, rate limiting degrades gracefully (no Redis needed for basic use)
REDIS_URL=redis://localhost:6379

# --- JWT Secret (shared with server) ---
# Must match the INGESTOR_JWT_SECRET on the server
# Generate: openssl rand -hex 32
INGESTOR_JWT_SECRET=any_long_random_string_here
