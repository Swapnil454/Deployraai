# DATABASE_URL: PostgreSQL connection for writing spans, logs, and metrics
DATABASE_URL=postgresql://admin:secret@localhost:5432/observability

# PORT: The port the Ingestor runs on (Default: 4317)
PORT=4317

INGESTOR_JWT_SECRET="any_long_random_string_here
# Railway Webhook
RAILWAY_WEBHOOK_SECRET=your_shared_railway_secret
