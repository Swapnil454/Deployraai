# ============================================================
# SYNTHETIC CHECKER WORKER — Environment Variables
# Deployed on: Railway / Render (background worker, no port)
# ============================================================

# --- PostgreSQL (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Region tag for this checker instance ---
# Used to label synthetic_checks rows so you know which region found an issue.
# Example: us-east-1, eu-west-1, ap-south-1
CHECKER_REGION=us-east-1
