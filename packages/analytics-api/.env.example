# ============================================================
# ANALYTICS API SERVICE — Environment Variables
# Deployed on: Railway / Render / Fly.io (any Node.js host)
# Port: 4318
# ============================================================

# --- PostgreSQL (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clickhouse ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# --- CORS ---
# Set to your production client domain (e.g. https://app.yourplatform.com)
CORS_ORIGIN=http://localhost:3000
