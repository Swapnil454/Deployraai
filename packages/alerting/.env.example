# ============================================================
# ALERTING WORKER — Environment Variables
# Deployed on: Railway / Render (background worker, no port)
# ============================================================

# --- PostgreSQL (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Encryption key for PagerDuty/Jira/Linear credentials ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
