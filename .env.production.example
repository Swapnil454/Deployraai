# =========================================================================
# TRACEPILOT PRODUCTION ENVIRONMENT VARIABLES
# =========================================================================
# This file serves as a reference for deploying the TracePilot stack across
# different platforms (Render, Railway, AWS, DigitalOcean, etc.).
#
# HOW CROSS-SERVICE COMMUNICATION WORKS:
# - Client (Next.js) calls Server (Node/Express).
# - Server proxies observability data from Analytics API.
# - SDKs send traces to Ingestor.
# - AI Agent provides explanation streams.
# - Synthetic Checker & Alerting run as standalone workers.
# =========================================================================

# -------------------------------------------------------------------------
# 1. SHARED INFRASTRUCTURE (Required for almost all services)
# -------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/tracepilot
CLICKHOUSE_URL=http://default:password@host:8123
REDIS_URL=redis://default:password@host:6379

# -------------------------------------------------------------------------
# 2. SERVER (Main API & Auth) - Port 5000
# -------------------------------------------------------------------------
# URL of your deployed Next.js frontend (for CORS and OAuth redirects)
FRONTEND_URL=https://app.tracepilot.com
CLIENT_URL=https://app.tracepilot.com

# URLs of your other deployed internal microservices
ANALYTICS_API_URL=http://analytics-api-internal-host:4318
INGESTOR_API_URL=http://ingestor-internal-host:4317
AI_AGENT_URL=http://ai-agent-internal-host:4319

# Secrets
JWT_SECRET=generate-a-secure-random-string
INGESTOR_JWT_SECRET=generate-another-secure-string
ENCRYPTION_KEY=32-byte-hex-string-for-aes-256

# Third Party
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# -------------------------------------------------------------------------
# 3. CLIENT (Next.js Frontend) - Port 3000
# -------------------------------------------------------------------------
# Must be set during build time (npm run build)
NEXT_PUBLIC_API_URL=https://api.tracepilot.com
NEXT_PUBLIC_AI_AGENT_URL=https://ai.tracepilot.com

# -------------------------------------------------------------------------
# 4. INGESTOR (OTLP Receiver) - Port 4317
# -------------------------------------------------------------------------
# Needs DATABASE_URL, CLICKHOUSE_URL, REDIS_URL
INGESTOR_JWT_SECRET=same-string-as-server
RESEND_API_KEY=re_your_resend_key_for_email_alerts

# -------------------------------------------------------------------------
# 5. ANALYTICS API (Query Engine) - Port 4318
# -------------------------------------------------------------------------
# Needs DATABASE_URL, CLICKHOUSE_URL
JWT_SECRET=same-string-as-server
CORS_ORIGIN=https://app.tracepilot.com

# -------------------------------------------------------------------------
# 6. AI AGENT (Anthropic integration) - Port 4319
# -------------------------------------------------------------------------
# Needs DATABASE_URL, REDIS_URL
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# -------------------------------------------------------------------------
# 7. ALERTING & SYNTHETIC CHECKER (Background Workers)
# -------------------------------------------------------------------------
# Both just need DATABASE_URL and CLICKHOUSE_URL.
# They don't expose web servers, they just run loops/crons.
REGION=us-east-1 # For synthetic checker to identify where checks run from
