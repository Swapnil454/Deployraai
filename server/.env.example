PORT=5000
NODE_ENV=development

# ============================================================
# DATABASE CONNECTIONS
# ============================================================

# PostgreSQL (Neon) — for observability data (issues, alerts, spans, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MongoDB — for user accounts, projects, deployments
MONGO_URI=your_mongodb_uri_here

# Redis (optional)
REDIS_URL=redis://localhost:6379

# ============================================================
# MICROSERVICE URLs
# These are the PUBLIC URLs of your deployed microservices.
# In local dev: localhost with port numbers.
# In production: the deployed service URLs from Railway/Render/Fly.io
# ============================================================

# Analytics API (port 4318 locally)
# Production: https://analytics-api.yourplatform.com  (from Railway/Render dashboard)
ANALYTICS_API_URL=http://localhost:4318

# AI Agent (port 4319 locally)
# Production: https://ai-agent.yourplatform.com  (from Railway/Render dashboard)
AI_AGENT_URL=http://localhost:4319

# Ingestor (port 4317 locally)
# Production: https://ingestor.yourplatform.com  (from Railway/Render dashboard)
INGESTOR_URL=http://localhost:4317

# ============================================================
# FRONTEND / BACKEND URLs
# ============================================================

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ============================================================
# AUTH
# ============================================================

JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
COOKIE_NAME=deployai_token
SERVER_SECRET_KEY=32_character_long_secret_key_here

# Shared secret between server and ingestor (for signing SDK tokens)
# Generate: openssl rand -hex 32
INGESTOR_JWT_SECRET=any_long_random_string_here

# ============================================================
# GITHUB OAuth
# ============================================================

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# ============================================================
# INTEGRATION PROVIDERS
# ============================================================

# Vercel OAuth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_CALLBACK_URL=http://localhost:5000/api/integrations/vercel/callback

# Netlify OAuth
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
NETLIFY_CALLBACK_URL=http://localhost:5000/api/integrations/netlify/callback

# Railway
RAILWAY_API_URL=https://backboard.railway.app/graphql/v2
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
RAILWAY_WEBHOOK_SECRET=your_shared_railway_secret

# Render
RENDER_API_URL=https://api.render.com/v1

# ============================================================
# AI
# ============================================================

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============================================================
# NOTIFICATIONS
# ============================================================

RESEND_API_KEY=
ALERT_FROM_EMAIL=DeployAI <alerts@yourdomain.com>

# ============================================================
# FIREBASE Admin SDK
# ============================================================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================================
# CLOUDINARY
# ============================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# BILLING
# ============================================================

STRIPE_PRICE_ID=price_mock_12345

# ============================================================
# SECURITY
# ============================================================

# AES-256-GCM Key for encrypting PagerDuty/Jira/Linear credentials (32-byte hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff